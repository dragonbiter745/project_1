# Razorpay settings for Cloud Functions / the emulator. Copy to functions/.env.local (gitignored).
# Deployed functions read the two secrets from Secret Manager instead (see docs/runbook.md).
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
