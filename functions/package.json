{
  "name": "functions",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore --project demo-foodcourt \"vitest run\"",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@foodcourt/shared": "file:foodcourt-shared-0.1.0.tgz",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "^20.17.19",
    "firebase": "11.10.0",
    "typescript": "^5.7.3",
    "vitest": "3.2.4"
  }
}
