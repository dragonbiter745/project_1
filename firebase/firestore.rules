rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMaster() {
      return signedIn() && request.auth.token.role == 'master';
    }
    // A shop's finance login: read-only money figures for that one shop (payouts go through financeAction).
    function isShopFinance(vendorId) {
      return signedIn() && request.auth.token.role == 'vendorFinance' && request.auth.token.vendorId == vendorId;
    }
    function isVendor(vendorId) {
      return signedIn()
        && (request.auth.token.role == 'vendorAdmin' || request.auth.token.role == 'vendorStaff')
        && request.auth.token.vendorId == vendorId;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if isMaster();
    }

    // Shop status: kitchens may only pause/resume and set their prep time.
    match /vendors/{vendorId} {
      allow read: if true;
      allow create, delete: if isMaster();
      allow update: if isMaster()
        || (isVendor(vendorId) && onlyChanges(['acceptingOrders', 'pausedUntil', 'defaultPrepMin', 'updatedAt'])
            && request.resource.data.acceptingOrders is bool
            && (!('defaultPrepMin' in request.resource.data) || (request.resource.data.defaultPrepMin is int
                && request.resource.data.defaultPrepMin >= 1 && request.resource.data.defaultPrepMin <= 120)));
    }

    // Menus and prices are changed by the court manager only; prices are re-checked server-side anyway.
    match /menus/{vendorId} {
      allow read: if true;
      allow write: if isMaster();
    }

    // Sold-out toggles: the shop's own staff, only the stock map.
    match /availability/{vendorId} {
      allow read: if true;
      allow create, update: if isMaster()
        || (isVendor(vendorId)
            && request.resource.data.vendorId == vendorId
            && request.resource.data.unavailable is map
            && request.resource.data.unavailable.size() <= 500
            && request.resource.data.keys().hasOnly(['vendorId', 'unavailable', 'updatedAt']));
      allow delete: if isMaster();
    }

    // Tables carry the secret QR tokens: never readable by diners (the server resolves tokens).
    match /tables/{tableId} {
      allow read, write: if isMaster();
    }

    match /sessions/{sessionId} {
      allow read: if isOwner(resource.data.uid) || isMaster();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.uid) || isMaster();
      allow write: if false;
    }

    match /subOrders/{subOrderId} {
      allow read: if isMaster() || isVendor(resource.data.vendorId) || isShopFinance(resource.data.vendorId) || isOwner(resource.data.uid);
      allow write: if false;
    }

    // Money sent to shops. Written only by the financeAction function, never deleted.
    match /payouts/{payoutId} {
      allow read: if isMaster() || isShopFinance(resource.data.vendorId);
      allow write: if false;
    }

    // Founder books (capital, expenses, drawings, profit shares): the court manager only.
    match /founders/{docId} {
      allow read: if isMaster();
      allow write: if false;
    }
    match /founderLedger/{entryId} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isMaster();
      allow write: if false;
    }

    match /pointsLedger/{id} {
      allow read: if isOwner(resource.data.uid) || isMaster();
      allow write: if false;
    }

    // Reports arrive through the reportIssue function (validated, rate-limited).
    match /issues/{id} {
      allow read, update: if isMaster();
      allow create, delete: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /auditLogs/{logId} {
      allow read: if isMaster();
      allow write: if false;
    }

    // Server-only bookkeeping.
    match /counters/{id} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }
  }
}
