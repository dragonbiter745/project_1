rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Menu images & QR codes: publicly readable
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'master' || request.auth.token.role == 'vendorAdmin');
    }
    
    // Vendor menu item photos
    match /menus/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'master' || request.auth.token.vendorId == vendorId);
    }
  }
}
