# Firebase Client Configuration for Vendor Kitchen POS App
# Copy this file to apps/vendor/.env
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=reva-nest-foodcourt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reva-nest-foodcourt
VITE_FIREBASE_STORAGE_BUCKET=reva-nest-foodcourt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
