# ==============================================================================
# REVA NEST FOOD COURT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the respective project / package directories.
# Never commit actual credentials, API keys, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION
# Target directories:
#   - apps/customer/.env
#   - apps/vendor/.env
#   - apps/master/.env
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=reva-nest-foodcourt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reva-nest-foodcourt
VITE_FIREBASE_STORAGE_BUCKET=reva-nest-foodcourt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. CASHFREE PAYMENT GATEWAY CONFIGURATION
# Target directory:
#   - functions/.env (and Google Secret Manager for production)
# ------------------------------------------------------------------------------
# Cashfree App ID / Client ID (from Cashfree Merchant Dashboard)
CASHFREE_APP_ID=your_cashfree_app_id_here

# Cashfree Secret Key (keep secret! Do not share)
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# Gateway environment: SANDBOX or PRODUCTION
CASHFREE_ENV=SANDBOX

# Cashfree Payment Gateway API Version
CASHFREE_API_VERSION=2023-08-01

# ------------------------------------------------------------------------------
# 3. SCRIPTS & QR GENERATOR CONFIGURATION (Optional)
# Target directory:
#   - scripts/.env or root .env
# ------------------------------------------------------------------------------
# Base URL encoded into table QR codes (defaults to production customer app)
CUSTOMER_APP_URL=https://order.getqrave.in
