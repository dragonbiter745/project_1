# ==============================================================================
# REVA NEST FOOD COURT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the respective project / package directories.
# Never commit actual credentials, API keys, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION
# Target directories:
#   - apps/customer/.env
#   - apps/vendor/.env
#   - apps/master/.env
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=reva-nest-foodcourt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reva-nest-foodcourt
VITE_FIREBASE_STORAGE_BUCKET=reva-nest-foodcourt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY CONFIGURATION
# Target directory:
#   - functions/.env.local for the emulator, Google Secret Manager for deployed functions
# The customer app needs no key of its own: createCheckout returns the public key id with each order.
# ------------------------------------------------------------------------------
# Public key id (rzp_test_... for test mode, rzp_live_... for live). Not secret.
RAZORPAY_KEY_ID=your_razorpay_key_id_here

# API key secret (keep secret! Never prefix with VITE_ or put it in an app)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret, chosen when you add the webhook in the Razorpay dashboard (not the key secret)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. SCRIPTS & QR GENERATOR CONFIGURATION (Optional)
# Target directory:
#   - scripts/.env or root .env
# ------------------------------------------------------------------------------
# Base URL encoded into table QR codes (defaults to production customer app)
CUSTOMER_APP_URL=https://order.getqrave.in
